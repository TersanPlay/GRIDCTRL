{
  "name": "@tersanplay/gridctrl",
  "version": "0.1.0",
  "description": "GRIDCTRL deterministic design tokens, CLI and AI-agent skill toolkit",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gridctrl": "./src/cli/index.js"
  },
  "exports": {
    ".": "./src/core/index.js",
    "./react": "./src/react/index.js",
    "./tokens.css": "./dist/gridctrl.css",
    "./tokens.json": "./dist/gridctrl.tokens.json",
    "./variants": "./skill/assets/variants.json"
  },
  "files": [
    "src/",
    "skill/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node src/cli/index.js build --out dist",
    "check": "node src/cli/index.js validate",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.10.0"
  }
}
